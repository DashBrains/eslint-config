{
  "name": "@dashbrains/eslint-config",
  "version": "1.0.9",
  "main": "index.js",
  "license": "MIT",
  "description": "Eslint configuration used by DashBrains",
  "keywords": [
    "eslint",
    "config",
    "dashbrains"
  ],
  "author": "DashBrains Engineering <contact@dashbrains.dev>",
  "homepage": "https://github.com/DashBrains/eslint-config#readme",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/DashBrains/eslint-config.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "bugs": {
    "url": "https://github.com/DashBrains/eslint-config/issues"
  },
  "scripts": {
    "lint:fix": "eslint '**/*.{js,jsx,ts,tsx}' --fix --no-error-on-unmatched-pattern",
    "format:fix": "prettier '**/*.{js,jsx,ts,tsx}' --write --no-error-on-unmatched-pattern",
    "lint": "eslint '**/*.{js,jsx,ts,tsx}' --no-error-on-unmatched-pattern",
    "format": "prettier '**/*.{js,jsx,ts,tsx}' --check --no-error-on-unmatched-pattern",
    "prepare": "husky install"
  },
  "dependencies": {
    "@eslint/compat": "^2.0.3",
    "eslint": "<10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7"
  }
}
