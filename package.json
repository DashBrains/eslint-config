{
  "name": "@dashbrains/eslint-config",
  "version": "1.1.0",
  "main": "index.js",
  "files": [
    "index.js",
    "typescript-api.js"
  ],
  "license": "MIT",
  "description": "Eslint configuration used by DashBrains",
  "keywords": [
    "eslint",
    "config",
    "dashbrains"
  ],
  "author": "DashBrains Engineering <contact@dashbrains.dev>",
  "homepage": "https://github.com/DashBrains/eslint-config#readme",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/DashBrains/eslint-config.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "bugs": {
    "url": "https://github.com/DashBrains/eslint-config/issues"
  },
  "scripts": {
    "lint:fix": "eslint '**/*.{js,jsx,ts,tsx}' --fix --no-error-on-unmatched-pattern",
    "format:fix": "prettier '**/*.{js,jsx,ts,tsx}' --write --no-error-on-unmatched-pattern",
    "lint": "eslint '**/*.{js,jsx,ts,tsx}' --no-error-on-unmatched-pattern",
    "format": "prettier '**/*.{js,jsx,ts,tsx}' --check --no-error-on-unmatched-pattern",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@typescript/typescript6": "^6.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "semver": "^7.8.6",
    "typescript-eslint": "^8.74.0"
  },
  "bundleDependencies": [
    "@typescript/typescript6"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1"
  },
  "peerDependencies": {
    "eslint": "^9.7.0 || ^10.0.0",
    "prettier": "^3.0.0"
  }
}
